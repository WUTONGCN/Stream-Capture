<Window x:Class="StreamCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="推流地址捕获工具 - Stream Capture" Height="700" Width="1200"
        Icon="favicon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0d1117"
        Foreground="#e6edf3">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 暗色细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid><Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Border Background="#30363d" CornerRadius="3" Margin="1" Opacity="0.7"/>
                            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        </Track></Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox 文字颜色 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 暗色 ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <Border x:Name="Bd" Grid.ColumnSpan="2" Background="#161b22" CornerRadius="6" BorderBrush="#30363d" BorderThickness="1"/>
                <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="#8b949e" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#58a6ff"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#c9d1d9"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#21262d"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#30363d"/><Setter Property="Foreground" Value="#e6edf3"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮 -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8b949e"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#21262d"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#da3633"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 功能按钮 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#58a6ff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#79b8ff"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f85149"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#da3633"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="#30363d" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== 自定义标题栏 ========== -->
            <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：应用名 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Stream Capture" FontSize="13" FontWeight="SemiBold" Foreground="#e6edf3" VerticalAlignment="Center"/>
                        <Border x:Name="VersionBadge" Background="#21262d" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                VerticalAlignment="Center" BorderBrush="#30363d" BorderThickness="1">
                            <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10" Foreground="#58a6ff"/>
                        </Border>

                    </StackPanel>

                    <!-- 中：功能按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="MIT · 本地社区版" Foreground="#58a6ff" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Content="配置平台" Style="{StaticResource ModernButton}"
                                Click="ConfigButton_Click" Margin="0,0,4,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- 右：窗口控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="─" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeBtn" Content="□" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 控制面板 ========== -->
            <Border Grid.Row="1" Background="#0d1117" Padding="14,10" BorderBrush="#30363d" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="网卡:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#8b949e"/>
                    <ComboBox Grid.Column="1" x:Name="DeviceComboBox"/>
                    <TextBlock Grid.Column="2" Text="平台:" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12" Foreground="#8b949e"/>
                    <StackPanel Grid.Column="3" x:Name="PlatformCheckBoxes" Orientation="Horizontal"/>
                    <Button x:Name="ToggleCaptureButton" Grid.Column="4" Content="开始捕获" Style="{StaticResource ModernButton}"
                            Click="ToggleCaptureButton_Click" Width="120" Padding="12,8" FontSize="13" Margin="12,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="False"/>
                </Grid>
            </Border>

            <!-- ========== 主内容 ========== -->
            <Border Grid.Row="2" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="捕获结果" FontSize="15" FontWeight="SemiBold" Foreground="#e6edf3"/>
                        <TextBlock x:Name="ResultCountText" Text="(0)" FontSize="13" Foreground="#8b949e" Margin="6,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ResultListBox">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#161b22" CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                            BorderBrush="#30363d" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                                <Border Background="#58a6ff" CornerRadius="4" Padding="8,3">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding PlatformIcon}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Platform}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#3fb950" CornerRadius="4" Padding="8,3" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Protocol}" Foreground="White" FontSize="12"/>
                                                </Border>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                         Foreground="#6e7681" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="地址:" FontSize="12" Foreground="#8b949e" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Url}" FontSize="12" TextWrapping="Wrap" Foreground="#e6edf3" VerticalAlignment="Top"/>
                                                <Button Grid.Column="2" Content="复制" Tag="{Binding Url}" Click="CopyUrlButton_Click"
                                                        Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11" Margin="6,0,0,0"/>
                                            </Grid>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="密钥:" FontSize="12" Foreground="#8b949e" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StreamKey}" FontSize="12" TextWrapping="Wrap" Foreground="#58a6ff" VerticalAlignment="Top" FontFamily="Consolas"/>
                                                <Button Grid.Column="2" Content="复制" Tag="{Binding StreamKey}" Click="CopyKeyButton_Click"
                                                        Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11" Margin="6,0,0,0"/>
                                            </Grid>

                                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="完整:" FontSize="12" Foreground="#8b949e" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Foreground="#6e7681" VerticalAlignment="Top" FontFamily="Consolas">
                                                    <Run Text="{Binding Url}"/><Run Text="{Binding StreamKey}"/>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="复制" Tag="{Binding}" Click="CopyFullButton_Click"
                                                        Style="{StaticResource ModernButton}" Background="#3fb950" Padding="8,3" FontSize="11" Margin="6,0,0,0"/>
                                            </Grid>

                                            <Grid Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="填写到OBS" Tag="{Binding}" Click="FillToObsButton_Click" Style="{StaticResource ModernButton}"
                                                            Background="#d29922" Padding="12,5" FontSize="12" Margin="0,0,6,0"/>
                                                    <Button Content="开始直播" Tag="{Binding}" Click="StartStreamButton_Click" Style="{StaticResource ModernButton}"
                                                            Background="#3fb950" Padding="12,5" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========== 底部状态栏 ========== -->
            <Border Grid.Row="3" Background="#161b22" Padding="14,6" BorderBrush="#30363d" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="状态:" Foreground="#6e7681" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="StatusText" Text="就绪" Foreground="#58a6ff" FontWeight="Medium" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="By WUTONG" Foreground="#30363d" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button Grid.Column="3" Content="清空结果" Style="{StaticResource StopButton}"
                            Click="ClearResultsButton_Click" Padding="10,4" FontSize="11"
                            WindowChrome.IsHitTestVisibleInChrome="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
