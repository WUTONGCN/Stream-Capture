# 项目编码规范
root = true

# 所有文件
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C# 文件
[*.cs]
indent_style = space
indent_size = 4

# XAML 文件
[*.xaml]
indent_style = space
indent_size = 4

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false

# Batch 文件
[*.bat]
end_of_line = crlf

# JavaScript 文件
[*.js]
indent_style = space
indent_size = 2

# Python 文件
[*.py]
indent_style = space
indent_size = 4

# C/C++ 文件
[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4
